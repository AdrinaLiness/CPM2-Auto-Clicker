<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.adrina.cpm2"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Android 11+: без <queries> не видно ни одного приложения —
         кнопка «ОТКРЫТЬ ИГРУ» не найдёт CPM2. Разрешаем видеть все
         запускаемые приложения. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

    <application
        android:label="CPM2 AI Driver"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:hardwareAccelerated="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Ядро: сервис доступности. Он вводит касания в игру
             (dispatchGesture) и на Android 14+ умеет ЗАПИСЫВАТЬ
             касания игрока (setMotionEventSources). -->
        <service
            android:name=".DriverService"
            android:exported="false"
            android:label="CPM2 AI Driver — ввод касаний"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/driver_service_config"/>
        </service>
    </application>
</manifest>
